#!/usr/bin/env bash
# Sobe a stack do robô dentro de um tmux (sobrevive à queda do SSH).
# PLANO_HEADLESS_2026-05-22 §4.3. Instalado em /usr/local/bin pelo setup_pi.sh.
#
# Uso:
#   robot-up [slam|nav2|trekking|teleop] [args extras do launch.sh]
#   robot-up nav2-trekking-slam [args extras]
#   robot-up nav2-trekking --map=maps/<mapa>.yaml [args extras]
#   robot-up                       # default: teleop
#   robot-up nav2 --map=maps/sala.yaml
#
# Já rodando? reanexa. Ctrl+B D pra destacar; robot-up de novo pra voltar.
set -euo pipefail

SESSION=robo
MODE="${1:-teleop}"
shift || true

# Resolve o repo: segue o symlink em /usr/local/bin até bin/ no checkout.
SELF="$(readlink -f "${BASH_SOURCE[0]}")"
REPO_DIR="$(cd "$(dirname "$SELF")/.." && pwd)"
cd "$REPO_DIR"

case "$MODE" in
    teleop|slam|nav2|trekking)
        LAUNCHER="$REPO_DIR/launch.sh"
        LAUNCH_MODE="--$MODE"
        ;;
    nav2-trekking-slam)
        LAUNCHER="$REPO_DIR/launch_nav2_trekking.sh"
        LAUNCH_MODE="--slam"
        ;;
    nav2-trekking)
        LAUNCHER="$REPO_DIR/launch_nav2_trekking.sh"
        LAUNCH_MODE="--nav2"
        ;;
    *)
        echo "ERRO: modo desconhecido '$MODE'." >&2
        echo "      Use teleop, slam, nav2, trekking, nav2-trekking-slam ou nav2-trekking." >&2
        exit 1
        ;;
esac

if [ ! -x "$LAUNCHER" ]; then
    echo "ERRO: launcher não encontrado ou não executável: $LAUNCHER" >&2
    echo "      O symlink em /usr/local/bin/ pode estar apontando pra um repo movido." >&2
    exit 1
fi

if tmux has-session -t "$SESSION" 2>/dev/null; then
    # Reanexa, mas avisa se o launch.sh já saiu (painel ficou só com bash).
    if ! pgrep -af "[l]aunch\.sh" >/dev/null 2>&1; then
        echo "AVISO: sessão '$SESSION' viva mas launch.sh não está rodando."
        echo "       Saia (Ctrl+D) e rode 'tmux kill-session -t $SESSION && robot-up $MODE' pra recomeçar."
    else
        echo "Sessão '$SESSION' já existe — reanexando (Ctrl+B D pra destacar)."
    fi
    exec tmux attach -t "$SESSION"
else
    echo "Subindo a stack ($MODE) na sessão tmux '$SESSION'..."
    # tmux recebe uma string de shell. `%q` preserva cada argumento e impede
    # que espaço/metacaractere em nome de mapa seja reinterpretado.
    printf -v LAUNCH_CMD '%q ' "$LAUNCHER" "$LAUNCH_MODE" "$@"
    # Mantém o painel aberto pra inspeção mesmo se o launcher sair.
    exec tmux new -s "$SESSION" "$LAUNCH_CMD; exec bash"
fi
