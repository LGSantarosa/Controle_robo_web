<?xml version="1.0"?>
<!--
  PISTA MINIMA — 1 cone, nada mais.

  Existe pra responder UMA pergunta, sem nenhum confundidor: ele chega SEMPRE
  no mesmo ponto? Pedido do dono depois da pista completa dar errado: "a
  abordagem deve comecar pequena, somente chegar ao primeiro cone no mesmo
  ponto SEMPRE, ai sim ir para os outros".

  Por isso aqui NAO existe: obstaculo no caminho, segundo waypoint, curva. So
  o robo, um cone a 4 m em linha reta, e chao livre. Qualquer erro que aparecer
  e do seguidor ou da odometria — nao tem mais nada pra culpar.

      y
    2.5   R ................> (C1)
          x=2.0              x=6.0

  Robo spawna em (2.0, 2.5) olhando +x. Cone em (6.0, 2.5).
  Paredes a 8+ m, fora do range_max de 5 m do cone_detector.
-->
<sdf version="1.9">
  <world name="trekking_min">

    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <plugin filename="gz-sim-physics-system"
            name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system"
            name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system"
            name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-sensors-system"
            name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>

    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry><plane><normal>0 0 1</normal><size>100 100</size></plane></geometry>
        </collision>
        <visual name="visual">
          <geometry><plane><normal>0 0 1</normal><size>100 100</size></plane></geometry>
          <material>
            <ambient>0.75 0.75 0.72 1</ambient>
            <diffuse>0.75 0.75 0.72 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="cone_1">
      <static>true</static><pose>6.0 2.5 0.225 0 0 0</pose>
      <link name="link">
        <collision name="col"><geometry><cylinder><radius>0.11</radius><length>0.45</length></cylinder></geometry></collision>
        <visual name="vis"><geometry><cylinder><radius>0.11</radius><length>0.45</length></cylinder></geometry>
          <material><ambient>0.9 0.35 0.05 1</ambient><diffuse>0.9 0.35 0.05 1</diffuse></material></visual>
      </link>
    </model>

    <model name="wall_west">
      <static>true</static><pose>-6 2.5 0.5 0 0 0</pose>
      <link name="link">
        <collision name="col"><geometry><box><size>0.2 30 1</size></box></geometry></collision>
        <visual name="vis"><geometry><box><size>0.2 30 1</size></box></geometry>
          <material><diffuse>0.6 0.6 0.7 1</diffuse></material></visual>
      </link>
    </model>
    <model name="wall_east">
      <static>true</static><pose>18 2.5 0.5 0 0 0</pose>
      <link name="link">
        <collision name="col"><geometry><box><size>0.2 30 1</size></box></geometry></collision>
        <visual name="vis"><geometry><box><size>0.2 30 1</size></box></geometry>
          <material><diffuse>0.6 0.6 0.7 1</diffuse></material></visual>
      </link>
    </model>
    <model name="wall_south">
      <static>true</static><pose>6 -12 0.5 0 0 0</pose>
      <link name="link">
        <collision name="col"><geometry><box><size>30 0.2 1</size></box></geometry></collision>
        <visual name="vis"><geometry><box><size>30 0.2 1</size></box></geometry>
          <material><diffuse>0.6 0.6 0.7 1</diffuse></material></visual>
      </link>
    </model>
    <model name="wall_north">
      <static>true</static><pose>6 17 0.5 0 0 0</pose>
      <link name="link">
        <collision name="col"><geometry><box><size>30 0.2 1</size></box></geometry></collision>
        <visual name="vis"><geometry><box><size>30 0.2 1</size></box></geometry>
          <material><diffuse>0.6 0.6 0.7 1</diffuse></material></visual>
      </link>
    </model>

  </world>
</sdf>
