<?xml version="1.0"?>
<!--
  PISTA DE TREKKING — cones como ALVO, obstáculos NO CAMINHO.

  Desenhada pra responder duas perguntas: ele acerta o ponto? e ele vai direito?
  O robô nasce em (2.0, 2.5) olhando pra +x. A rota é gravada dirigindo: em cada
  estação você para de frente pro cone e aperta "+ Ponto". Entre uma estação e
  outra tem um obstáculo EM CIMA da linha reta, então a rota gravada
  obrigatoriamente contorna — e o Play tem que repetir o mesmo contorno.

  ┌──────────────────────────────────────────────────────────────┐
  │  y                                                            │
  │ 11        [B5]         C4                                     │
  │ 10                          [B4]                              │
  │  9   C5                              C3                       │
  │  8                                                            │
  │  7  [B6]                  [B3]                                │
  │  6                                                            │
  │  5        C6                    C2                            │
  │  4                                                            │
  │  3              [B2]                                          │
  │  2   R ..>[B1]..> C1                                          │
  │      2    4    6    8   10   12   14                       x  │
  └──────────────────────────────────────────────────────────────┘

  ORDEM: R > C1 > C2 > C3 > C4 > C5 > C6 (volta perto do início)

  CONES (o alvo): cilindro r=0,11 -> 22 cm de largura aparente, altura 0,45 m
    (o LiDAR do sim está a 0,10 m do chão). Medido: detectado com 0,20-0,22 m.

  OBSTÁCULOS (o caminho): caixas de 1,2 m e barreiras de 2,0 m. GRANDES DE
    PROPÓSITO. O `cone_detector` aceita cluster ISOLADO de 4-45 cm — ele não
    tem como distinguir um cone de qualquer outro objeto isolado desse tamanho.
    Um barril de ~50 cm visto de longe cai com folga na janela e vira ALVO
    FALSO. Por isso nada aqui tem tamanho ambíguo: ou é cone, ou é grande.

  DISTÂNCIAS conferidas: todo obstáculo fica a >= 1,7 m do cone mais próximo
  (não funde cluster nem oculta o alvo) e os cones ficam a >= 3 m entre si.

  PAREDES: a 8+ m da pista, fora do range_max de 5 m do detector. Só contêm o
  robô; nunca geram candidato a cone enquanto ele corre a pista.
-->
<sdf version="1.9">
  <world name="trekking">

    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <plugin filename="gz-sim-physics-system"
            name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system"
            name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system"
            name="gz::sim::systems::SceneBroadcaster"/>
    <!-- IMU: sem este system o <sensor type="imu"> do sim_robot fica MUDO e o
         sim volta a estimar yaw por RODA (o modo degradado do robo real).
         Ver o comentario do sensor em urdf/sim_robot.sdf (2026-08-26). -->
    <plugin filename="gz-sim-imu-system"
            name="gz::sim::systems::Imu"></plugin>
    <plugin filename="gz-sim-sensors-system"
            name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>

    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry><plane><normal>0 0 1</normal><size>100 100</size></plane></geometry>
        </collision>
        <visual name="visual">
          <geometry><plane><normal>0 0 1</normal><size>100 100</size></plane></geometry>
          <material>
            <ambient>0.75 0.75 0.72 1</ambient>
            <diffuse>0.75 0.75 0.72 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- ==================== CONES = AS ESTAÇÕES DA PISTA ==================== -->
    <!-- C1 (6.0, 2.5)  reto a 4 m do start, com a barreira B1 no meio -->
    <model name="cone_1">
      <static>true</static><pose>6.0 2.5 0.225 0 0 0</pose>
      <link name="link">
        <collision name="col"><geometry><cylinder><radius>0.11</radius><length>0.45</length></cylinder></geometry></collision>
        <visual name="vis"><geometry><cylinder><radius>0.11</radius><length>0.45</length></cylinder></geometry>
          <material><ambient>0.9 0.35 0.05 1</ambient><diffuse>0.9 0.35 0.05 1</diffuse></material></visual>
      </link>
    </model>
    <!-- C2 (10.0, 5.0) -->
    <model name="cone_2">
      <static>true</static><pose>10.0 5.0 0.225 0 0 0</pose>
      <link name="link">
        <collision name="col"><geometry><cylinder><radius>0.11</radius><length>0.45</length></cylinder></geometry></collision>
        <visual name="vis"><geometry><cylinder><radius>0.11</radius><length>0.45</length></cylinder></geometry>
          <material><ambient>0.9 0.35 0.05 1</ambient><diffuse>0.9 0.35 0.05 1</diffuse></material></visual>
      </link>
    </model>
    <!-- C3 (13.0, 9.0) -->
    <model name="cone_3">
      <static>true</static><pose>13.0 9.0 0.225 0 0 0</pose>
      <link name="link">
        <collision name="col"><geometry><cylinder><radius>0.11</radius><length>0.45</length></cylinder></geometry></collision>
        <visual name="vis"><geometry><cylinder><radius>0.11</radius><length>0.45</length></cylinder></geometry>
          <material><ambient>0.9 0.35 0.05 1</ambient><diffuse>0.9 0.35 0.05 1</diffuse></material></visual>
      </link>
    </model>
    <!-- C4 (8.0, 11.0) -->
    <model name="cone_4">
      <static>true</static><pose>8.0 11.0 0.225 0 0 0</pose>
      <link name="link">
        <collision name="col"><geometry><cylinder><radius>0.11</radius><length>0.45</length></cylinder></geometry></collision>
        <visual name="vis"><geometry><cylinder><radius>0.11</radius><length>0.45</length></cylinder></geometry>
          <material><ambient>0.9 0.35 0.05 1</ambient><diffuse>0.9 0.35 0.05 1</diffuse></material></visual>
      </link>
    </model>
    <!-- C5 (3.0, 9.0) -->
    <model name="cone_5">
      <static>true</static><pose>3.0 9.0 0.225 0 0 0</pose>
      <link name="link">
        <collision name="col"><geometry><cylinder><radius>0.11</radius><length>0.45</length></cylinder></geometry></collision>
        <visual name="vis"><geometry><cylinder><radius>0.11</radius><length>0.45</length></cylinder></geometry>
          <material><ambient>0.9 0.35 0.05 1</ambient><diffuse>0.9 0.35 0.05 1</diffuse></material></visual>
      </link>
    </model>
    <!-- C6 (2.5, 5.5)  volta pra perto do start -->
    <model name="cone_6">
      <static>true</static><pose>2.5 5.5 0.225 0 0 0</pose>
      <link name="link">
        <collision name="col"><geometry><cylinder><radius>0.11</radius><length>0.45</length></cylinder></geometry></collision>
        <visual name="vis"><geometry><cylinder><radius>0.11</radius><length>0.45</length></cylinder></geometry>
          <material><ambient>0.9 0.35 0.05 1</ambient><diffuse>0.9 0.35 0.05 1</diffuse></material></visual>
      </link>
    </model>

    <!-- ============ OBSTÁCULOS: um EM CIMA de cada perna da rota ============ -->
    <!-- B1 (4.0, 2.5) barreira 2 m atravessada entre o start e C1 -->
    <model name="obst_1">
      <static>true</static><pose>4.0 2.5 0.35 0 0 0</pose>
      <link name="link">
        <collision name="col"><geometry><box><size>0.4 2.0 0.7</size></box></geometry></collision>
        <visual name="vis"><geometry><box><size>0.4 2.0 0.7</size></box></geometry>
          <material><diffuse>0.35 0.38 0.45 1</diffuse></material></visual>
      </link>
    </model>
    <!-- B2 (8.0, 3.7) no meio de C1 p/ C2 -->
    <model name="obst_2">
      <static>true</static><pose>8.0 3.7 0.3 0 0 0</pose>
      <link name="link">
        <collision name="col"><geometry><box><size>1.2 1.2 0.6</size></box></geometry></collision>
        <visual name="vis"><geometry><box><size>1.2 1.2 0.6</size></box></geometry>
          <material><diffuse>0.45 0.45 0.5 1</diffuse></material></visual>
      </link>
    </model>
    <!-- B3 (11.5, 7.0) no meio de C2 p/ C3 -->
    <model name="obst_3">
      <static>true</static><pose>11.5 7.0 0.3 0 0 0</pose>
      <link name="link">
        <collision name="col"><geometry><box><size>1.2 1.2 0.6</size></box></geometry></collision>
        <visual name="vis"><geometry><box><size>1.2 1.2 0.6</size></box></geometry>
          <material><diffuse>0.45 0.45 0.5 1</diffuse></material></visual>
      </link>
    </model>
    <!-- B4 (10.5, 10.0) no meio de C3 p/ C4 -->
    <model name="obst_4">
      <static>true</static><pose>10.5 10.0 0.35 0 0 0</pose>
      <link name="link">
        <collision name="col"><geometry><box><size>2.0 0.4 0.7</size></box></geometry></collision>
        <visual name="vis"><geometry><box><size>2.0 0.4 0.7</size></box></geometry>
          <material><diffuse>0.35 0.38 0.45 1</diffuse></material></visual>
      </link>
    </model>
    <!-- B5 (5.5, 10.0) no meio de C4 p/ C5 -->
    <model name="obst_5">
      <static>true</static><pose>5.5 10.0 0.3 0 0 0</pose>
      <link name="link">
        <collision name="col"><geometry><box><size>1.2 1.2 0.6</size></box></geometry></collision>
        <visual name="vis"><geometry><box><size>1.2 1.2 0.6</size></box></geometry>
          <material><diffuse>0.45 0.45 0.5 1</diffuse></material></visual>
      </link>
    </model>
    <!-- B6 (2.75, 7.25) no meio de C5 p/ C6 -->
    <model name="obst_6">
      <static>true</static><pose>2.75 7.25 0.3 0 0 0</pose>
      <link name="link">
        <collision name="col"><geometry><box><size>1.2 1.2 0.6</size></box></geometry></collision>
        <visual name="vis"><geometry><box><size>1.2 1.2 0.6</size></box></geometry>
          <material><diffuse>0.45 0.45 0.5 1</diffuse></material></visual>
      </link>
    </model>

    <!-- ============ PAREDES: longe, fora do alcance do detector ============ -->
    <model name="wall_west">
      <static>true</static><pose>-6 7 0.5 0 0 0</pose>
      <link name="link">
        <collision name="col"><geometry><box><size>0.2 30 1</size></box></geometry></collision>
        <visual name="vis"><geometry><box><size>0.2 30 1</size></box></geometry>
          <material><diffuse>0.6 0.6 0.7 1</diffuse></material></visual>
      </link>
    </model>
    <model name="wall_east">
      <static>true</static><pose>22 7 0.5 0 0 0</pose>
      <link name="link">
        <collision name="col"><geometry><box><size>0.2 30 1</size></box></geometry></collision>
        <visual name="vis"><geometry><box><size>0.2 30 1</size></box></geometry>
          <material><diffuse>0.6 0.6 0.7 1</diffuse></material></visual>
      </link>
    </model>
    <model name="wall_south">
      <static>true</static><pose>8 -6 0.5 0 0 0</pose>
      <link name="link">
        <collision name="col"><geometry><box><size>30 0.2 1</size></box></geometry></collision>
        <visual name="vis"><geometry><box><size>30 0.2 1</size></box></geometry>
          <material><diffuse>0.6 0.6 0.7 1</diffuse></material></visual>
      </link>
    </model>
    <model name="wall_north">
      <static>true</static><pose>8 20 0.5 0 0 0</pose>
      <link name="link">
        <collision name="col"><geometry><box><size>30 0.2 1</size></box></geometry></collision>
        <visual name="vis"><geometry><box><size>30 0.2 1</size></box></geometry>
          <material><diffuse>0.6 0.6 0.7 1</diffuse></material></visual>
      </link>
    </model>

  </world>
</sdf>
